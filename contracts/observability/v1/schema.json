{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr.dev/contracts/observability/1.0/schema.json",
  "title": "Herdr observability extension contract 1.0",
  "type": "object",
  "required": ["descriptor", "snapshot"],
  "additionalProperties": false,
  "properties": {
    "descriptor": { "$ref": "#/$defs/descriptor" },
    "snapshot": { "$ref": "#/$defs/snapshot" }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "additionalProperties": false,
      "properties": {
        "major": { "type": "integer", "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "health": {
      "type": "string",
      "enum": ["available", "unavailable", "degraded", "offline", "incompatible", "unauthorized"]
    },
    "signal": {
      "type": "string",
      "enum": ["traces", "logs", "metrics", "activity"]
    },
    "operation": {
      "type": "string",
      "enum": ["snapshot", "events"]
    },
    "targetKind": {
      "type": "string",
      "enum": ["host", "workspace", "tab", "pane", "terminal", "agent_session"]
    },
    "target": {
      "type": "object",
      "required": ["bridge_id", "kind", "native_id"],
      "additionalProperties": false,
      "properties": {
        "bridge_id": { "$ref": "#/$defs/safeId" },
        "kind": { "$ref": "#/$defs/targetKind" },
        "native_id": { "$ref": "#/$defs/safeId" }
      }
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "capability": {
      "type": "object",
      "required": ["signal", "operations"],
      "additionalProperties": false,
      "properties": {
        "signal": { "$ref": "#/$defs/signal" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["mode", "max_age_ms"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["live", "polling", "unknown"] },
        "max_age_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "descriptor": {
      "type": "object",
      "required": [
        "extension_id",
        "contract_version",
        "provider_id",
        "capabilities",
        "target_scopes",
        "freshness",
        "health",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "extension_id": { "const": "observability" },
        "contract_version": { "$ref": "#/$defs/version" },
        "provider_id": { "$ref": "#/$defs/safeId" },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "target_scopes": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetKind" }
        },
        "freshness": { "$ref": "#/$defs/freshness" },
        "health": { "$ref": "#/$defs/health" },
        "observed_at": { "type": "integer", "minimum": 0 }
      }
    },
    "truncated": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["size_limit", "field_limit", "retention_limit", "provider_policy"]
        },
        "original_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/safeId" }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["namespace", "data"],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "data": {}
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "extension_id",
        "contract_version",
        "provider_id",
        "observed_at",
        "status",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "extension_id": { "const": "observability" },
        "contract_version": { "$ref": "#/$defs/version" },
        "provider_id": { "$ref": "#/$defs/safeId" },
        "target": { "$ref": "#/$defs/target" },
        "observed_at": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/health" },
        "payload": { "$ref": "#/$defs/payload" },
        "truncated": { "$ref": "#/$defs/truncated" },
        "sequence": { "type": "integer", "minimum": 1 },
        "replay": {
          "type": "object",
          "required": ["replayed", "gap"],
          "additionalProperties": false,
          "properties": {
            "replayed": { "type": "boolean" },
            "gap": { "type": "boolean" },
            "cursor": { "type": ["string", "null"], "maxLength": 256 }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["sequence", "envelopes"],
      "additionalProperties": false,
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "envelopes": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/envelope" }
        }
      }
    }
  }
}
